# 复制本文件为 .env 并填入真实值；config.yaml 中 api_key 留空时会从这里读取。

# 方式一：调用 OpenAI 兼容接口（OpenAI / DeepSeek / 通义千问 / 智谱 等）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 可选：覆盖 config.yaml 中的 base_url（写到域名或 /v1 为止，程序自动补 /chat/completions）
# DeepSeek 官方地址：https://api.deepseek.com
# OPENAI_BASE_URL=https://api.deepseek.com
# 可选：覆盖模型名（DeepSeek 可选 deepseek-flash / deepseek-v4-pro）
# OPENAI_MODEL=deepseek-flash

# 方式二：调用本地 Ollama（无需 Key，需先 ollama serve）
# OLLAMA_HOST=http://localhost:11434
